# PayPal Configuration
# Replace with your actual PayPal Client ID
# For testing, use Sandbox Client ID from https://developer.paypal.com/
VITE_PAYPAL_CLIENT_ID=your?api

# Default country (MX | JM | DO). Leave empty to force the country modal on first visit.
VITE_DEFAULT_COUNTRY=

# Tax rates by country (USD-based; 0 means no tax line shown)
VITE_TAX_RATE_MX=0.16
VITE_TAX_RATE_JM=0
VITE_TAX_RATE_DO=0

# Payment provider toggles per country (true|false)
VITE_ENABLE_PAYPAL_MX=true
VITE_ENABLE_PAYPAL_JM=true
VITE_ENABLE_PAYPAL_DO=true
VITE_ENABLE_STRIPE_MX=true
VITE_ENABLE_STRIPE_JM=true
VITE_ENABLE_STRIPE_DO=true

# Stripe — charges in USD for any wedding destination (card / Apple Pay / Google Pay).
# Test key shown; for go-live replace with pk_live_... (and sk_live_... on the API).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email API URL (backend server)
VITE_API_URL=http://localhost:5000

# Enable Test Package
VITE_ENABLE_TEST_PACKAGE=true
